      ],
      "id": "2c3c1bfe-bd8a-4414-bfa0-0981e1d9e012",
      "name": "HTTP Request Investimento"
    },
    {
      "parameters": {
        "mode": "combineBySql",
        "query": "SELECT \n    input1.Nome AS Nome,\n    input1.Email AS Email,\n    input1.Saldo AS Saldo,\n    input1.Perfil AS Perfil,\n    input2.Nome AS Nome_Investimento,\n    input2.Email AS Rendimento_Investimento,\n    input2.Saldo AS Minimo_Investimento\nFROM input1\nINNER JOIN input2 \n    ON input1.Perfil = input2.Perfil\n",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        448,
        656
      ],
      "id": "a92b9832-9c0e-41fc-904a-3a10365d4031",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst clientesMap = {};\n\n// 1. Agrupa os investimentos dentro de cada cliente usando o Email como chave única\nfor (let item of items) {\n  const data = item.json;\n  const emailCliente = data.Email;\n\n  // Se o cliente ainda não foi adicionado ao mapa, inicializa ele\n  if (!clientesMap[emailCliente]) {\n    clientesMap[emailCliente] = {\n      Nome: data.Nome,\n      Email: data.Email,\n      Saldo: data.Saldo,\n      Perfil: data.Perfil,\n      Investimentos_Recomendados: []\n    };\n  }\n\n  // Adiciona o investimento atual à lista desse cliente se ele existir\n  if (data.Nome_Investimento) {\n    clientesMap[emailCliente].Investimentos_Recomendados.push({\n      Produto: data.Nome_Investimento,\n      Rentabilidade: data.Rendimento_Investimento,\n      Minimo: data.Minimo_Investimento\n    });\n  }\n}\n\n// 2. Transforma o mapa de clientes de volta no formato de lista do n8n e cria o pre-prompt\nconst result = [];\n\nfor (let email in clientesMap) {\n  const cliente = clientesMap[email];\n\n  // Cria o texto dos investimentos formatado para o pre-prompt\n  let textoInvestimentos = '';\n  cliente.Investimentos_Recomendados.forEach((inv, index) => {\n    textoInvestimentos += `${index + 1}. ${inv.Produto}\\n   - Rentabilidade: ${inv.Rentabilidade}\\n   - Aplicação Mínima: ${inv.Minimo}\\n\\n`;\n  });\n\n  // Monta o Pre-Prompt único consolidado para este cliente\n  const prePrompt = `Você é um assessor de investimentos especializado. Crie uma mensagem de recomendação personalizada para o cliente contendo TODOS os produtos listados abaixo:\n\n[DADOS DO CLIENTE]\nNome: ${cliente.Nome}\nE-mail: ${cliente.Email}\nPerfil de Investidor: ${cliente.Perfil}\nSaldo Disponível: ${cliente.Saldo}\n\n[PRODUTOS RECOMENDADOS]\n${textoInvestimentos}\n[INSTRUÇÕES DA MENSAGEM]\nEscreva um e-mail persuasivo e estruturado. Apresente as opções acima como uma carteira recomendada ideal para o perfil \"${cliente.Perfil}\" dele. Mantenha um tom profissional, amigável e consultivo.`;\n\n  // Salva no formato final que o n8n espera\n  result.push({\n    json: {\n      ...cliente,\n      pre_prompt: prePrompt\n    }\n  });\n}\n\nreturn result;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        656
      ],
      "id": "4c062488-d1ce-497c-8f05-42d95ea5dacd",
      "name": "Codigo para gerar o Prompt"
    },
    {
      "parameters": {
        "jsCode": "// Captura a string CSV que está dentro da propriedade \"data\"\nconst csvRaw = $input.first().json.data || \"\";\n\n// Divide o texto por linhas e remove linhas vazias\nconst linhas = csvRaw.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n\n// Remove a primeira linha (cabeçalhos originais: perfil, produto, minimo, rentabilidade)\nconst cabecalhos = linhas.shift();\n\n// Mapeia cada linha para o formato JSON desejado\nreturn linhas.map(linha => {\n  // Divide a linha pelas vírgulas\n  const colunas = linha.split(',');\n\n  return {\n    json: {\n      Nome: colunas[1] ? colunas[1].trim() : '',       // O produto mapeia para \"Nome\"\n      Email: colunas[3] ? colunas[3].trim() : '',      // A rentabilidade mapeia para \"Email\"\n      Saldo: colunas[2] ? colunas[2].trim() : '',      // O valor mínimo mapeia para \"Saldo\"\n      Perfil: colunas[0] ? colunas[0].trim() : ''      // O perfil mapeia para \"Perfil\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        560
      ],
      "id": "f59b8320-ca55-4c3e-94c9-54e45c300549",
      "name": "Code para formatar o investimento"
    },
    {
      "parameters": {
        "jsCode": "// Acessa a lista de clientes dentro do corpo (body) da requisição\nconst clientes = typeof $input.item.json.body === 'string' \n  ? JSON.parse(_input.item.json.body).clientes \n  : $input.item.json.body.clientes;\n\n// Transforma cada cliente em um formato nativo do n8n (um item por cliente)\nreturn clientes.map(cliente => {\n  return {\n    json: {\n      Nome: cliente.nome,\n      Email: cliente.email,\n      Saldo: cliente.saldo,\n      Perfil: cliente.perfil\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        752
      ],
      "id": "d61b3094-86e6-491b-8aff-bf5eeebbe367",
